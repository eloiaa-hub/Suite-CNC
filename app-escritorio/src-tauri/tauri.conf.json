{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simulador 3D",
  "mainBinaryName": "Simulador3D",
  "version": "0.1.0",
  "identifier": "es.eloiaa.suitecnc.simulador3d",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": "node scripts/preparar.mjs",
    "beforeBuildCommand": "node scripts/preparar.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "msi", "nsis"],
    "category": "Education",
    "publisher": "Eloi A.A.",
    "copyright": "Eloi A.A. — EUPL-1.2",
    "shortDescription": "Simulador de programas G-code en 3D",
    "longDescription": "Simulador G-Code 3D de la Suite CNC: visualiza el recorrido de la fresa y el material mecanizado, revisa el programa y lo compara con el plano del ejercicio.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["sim3d"],
        "name": "Proyecto Simulador 3D",
        "description": "Proyecto del Simulador 3D (Suite CNC)",
        "role": "Editor",
        "mimeType": "application/x-sim3d"
      }
    ]
  }
}
